<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft Drop Shadow Beneath Pocket -->
    <path
        android:pathData="M 32,80 C 32,80 42,84 54,84 C 66,84 76,80 76,80 C 76,80 66,82 54,82 C 42,82 32,80 32,80 Z"
        android:fillColor="#50000000" />

    <!-- Payment Card (protruding from the pocket) -->
    <!-- Card Body: rounded rect (x: 34 to 74, y: 28 to 58, radius: 5) -->
    <path
        android:pathData="M 39,28 L 69,28 C 72,28 74,30 74,33 L 74,58 L 34,58 L 34,33 C 34,30 36,28 39,28 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="34"
                android:startY="28"
                android:endX="74"
                android:endY="58"
                android:type="linear">
                <item android:offset="0.0" android:color="#8E6BF8" />
                <item android:offset="0.5" android:color="#7C5CFC" />
                <item android:offset="1.0" android:color="#5236D4" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Card Top Edge Highlight Line -->
    <path
        android:pathData="M 39,29 L 69,29"
        android:strokeWidth="0.8"
        android:strokeColor="#60FFFFFF"
        android:strokeLineCap="round" />

    <!-- Card EMV Gold Chip -->
    <path
        android:pathData="M 40,35 L 46,35 C 47,35 47.5,35.5 47.5,36.5 L 47.5,41 C 47.5,42 47,42.5 46,42.5 L 40,42.5 C 39,42.5 38.5,42 38.5,41 L 38.5,36.5 C 38.5,35.5 39,35 40,35 Z"
        android:fillColor="#FFD166" />
    <path
        android:pathData="M 40,38.8 L 46,38.8"
        android:strokeWidth="0.5"
        android:strokeColor="#C59B27" />
    <path
        android:pathData="M 43,35 L 43,42.5"
        android:strokeWidth="0.5"
        android:strokeColor="#C59B27" />

    <!-- Card Contactless Indicator Arcs -->
    <path
        android:pathData="M 64,36 C 65,37.5 65,39.5 64,41"
        android:strokeWidth="1"
        android:strokeColor="#B0FFFFFF"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M 67,34 C 69,36.5 69,40.5 67,43"
        android:strokeWidth="1"
        android:strokeColor="#80FFFFFF"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Pocket Shadow Cast on Card -->
    <path
        android:pathData="M 28,47 Q 54,53 80,47 L 80,52 Q 54,58 28,52 Z"
        android:fillColor="#25000000" />

    <!-- Front Pocket / Wallet Outer Body -->
    <!-- Width: x=28 to 80, height: y=47 to 79, rounded bottom corners (radius 10) -->
    <path
        android:pathData="M 28,47 Q 54,53 80,47 L 80,69 C 80,75 75,79 69,79 L 39,79 C 33,79 28,75 28,69 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="28"
                android:startY="47"
                android:endX="80"
                android:endY="79"
                android:type="linear">
                <item android:offset="0.0" android:color="#1A263D" />
                <item android:offset="0.4" android:color="#141E32" />
                <item android:offset="1.0" android:color="#0F1726" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Pocket Border Stroke with Gradient/Accent -->
    <path
        android:pathData="M 28,47 Q 54,53 80,47 L 80,69 C 80,75 75,79 69,79 L 39,79 C 33,79 28,75 28,69 Z"
        android:strokeWidth="1.2"
        android:strokeColor="#2F4263"
        android:fillColor="#00000000" />

    <!-- Pocket Top Rim Accent (Subtle Mint/Cyan Sheen) -->
    <path
        android:pathData="M 28.5,47 Q 54,53 79.5,47"
        android:strokeWidth="1.2"
        android:strokeColor="#00E6A1"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Subtle Pocket Stitching Line -->
    <path
        android:pathData="M 31,52 Q 54,57 77,52 L 77,69 C 77,73 73,76.5 69,76.5 L 39,76.5 C 35,76.5 31,73 31,69 Z"
        android:strokeWidth="0.6"
        android:strokeColor="#1F2F47"
        android:fillColor="#00000000" />

    <!-- Central Glowing Indian Rupee Symbol (₹) -->
    <!-- Top Horizontal Bar -->
    <path
        android:pathData="M 46.5,58 L 61.5,58"
        android:strokeWidth="2.2"
        android:strokeColor="#00E6A1"
        android:strokeLineCap="round" />

    <!-- Middle Horizontal Bar -->
    <path
        android:pathData="M 46.5,62.2 L 58,62.2"
        android:strokeWidth="2.2"
        android:strokeColor="#00E6A1"
        android:strokeLineCap="round" />

    <!-- Vertical Stem + Upper Curve + Diagonal Leg -->
    <path
        android:pathData="M 50.8,58 L 50.8,66 C 55,66 58.5,64.8 58.5,61.8 C 58.5,58.8 55,58 50.8,58 Z"
        android:fillColor="#00E6A1" />

    <!-- Inner Cutout for Upper Curve of Rupee -->
    <path
        android:pathData="M 52.8,60 L 52.8,64 C 54.6,64 56.4,63.2 56.4,61.8 C 56.4,60.5 54.6,60 52.8,60 Z"
        android:fillColor="#141E32" />

    <!-- Diagonal Leg of Rupee -->
    <path
        android:pathData="M 52,65 L 61.5,74.5"
        android:strokeWidth="2.4"
        android:strokeColor="#00E6A1"
        android:strokeLineCap="round" />

    <!-- Subtle Shine Highlight across Pocket -->
    <path
        android:pathData="M 28,47 L 46,47 L 34,79 L 28,79 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="28"
                android:startY="47"
                android:endX="46"
                android:endY="79"
                android:type="linear">
                <item android:offset="0.0" android:color="#12FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

</vector>